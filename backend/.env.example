# Aura Bell backend environment configuration

APP_NAME="Aura Bell API"
APP_ENV=development  # Use "production" for production deployment

# PostgreSQL async connection URL (asyncpg driver).
# Local Supabase DB:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@127.0.0.1:54330/postgres"
# Production example:
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Supabase project credentials (hosted DB + Auth).
# Local Supabase:
SUPABASE_URL="http://127.0.0.1:54331"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
# Production: use your actual Supabase project URL and keys

# Redis configuration
# Local:
REDIS_URL="redis://127.0.0.1:6379/0"
# Production: REDIS_URL="rediss://user:password@host:6379/0"
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0

# Rate limiting configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PAYMENT_PER_MINUTE=5
RATE_LIMIT_COMMUNITY_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=100

# External API timeouts
HTTP_TIMEOUT_CONNECT=5.0
HTTP_TIMEOUT_READ=30.0
HTTP_TIMEOUT_TOTAL=60.0

# AmarPay configuration
AMARPAY_STORE_ID="your-store-id"
AMARPAY_SIGNATURE_KEY="your-signature-key"
AMARPAY_BASE_URL="https://sandbox.aamarpay.com"
AMARPAY_ENVIRONMENT="sandbox"  # Use "production" for live

# CORS configuration
# Local:
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Production: CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
CORS_ALLOW_CREDENTIALS=true

# Trusted hosts
# Local:
TRUSTED_HOSTS="localhost,127.0.0.1,*.localhost,testserver"
# Production: TRUSTED_HOSTS="yourdomain.com,www.yourdomain.com"

# Application base URL
# Local:
APP_BASE_URL="http://localhost:8000"
# Production: APP_BASE_URL="https://api.yourdomain.com"

# Security
# Generate a strong secret: openssl rand -base64 32
SESSION_SECRET_KEY="your-session-secret-key-min-32-chars"
SESSION_COOKIE_SECURE=false  # Must be true in production
SESSION_COOKIE_SAMESITE="lax"