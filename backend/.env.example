# Aura Bell backend environment configuration (Local Development)

APP_NAME="Aura Bell API"
APP_ENV=development

# PostgreSQL async connection URL (Local Supabase DB)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@127.0.0.1:54330/postgres"

# Local Supabase Settings
# ⚠️ NOTE: Replace these placeholders with actual keys before production use
SUPABASE_URL="http://127.0.0.1:54331"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"