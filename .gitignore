# ==============================================================================
# Aura Bell — Production .gitignore
# ==============================================================================

# Environment variables & secrets (STRICTLY FORBIDDEN IN GIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Node & Next.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.vercel

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Database & local sqlite files
*.sqlite3
*.db
local_postgres_data/

# Temporary and log files
*.log
tmp/
temp/
